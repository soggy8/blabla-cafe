# Local or Docker PostgreSQL
POSTGRES_DB=blabla
POSTGRES_USER=blabla
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://blabla:replace-with-a-long-random-password@localhost:5432/blabla

# First owner account (created once at container startup)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-at-least-16-random-characters

# Public deployment
NEXT_PUBLIC_SITE_URL=https://cafe.example.com
APP_PORT=3000
# Interface the app port is published on. Keep 127.0.0.1 when a reverse proxy
# runs on the same machine.
APP_BIND=127.0.0.1
UPLOAD_DIR=./storage/uploads

# Protects POST /api/meta/sync (called by the scheduler service every 6 hours)
CRON_SECRET=replace-with-another-long-random-secret

# Add only after the café authorizes its Instagram Professional account
META_GRAPH_VERSION=v24.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Seconds between Instagram syncs (default 6 hours)
SYNC_EVERY_SECONDS=21600

# Optional: URL from a dead-man's-switch monitor (e.g. healthchecks.io). The
# scheduler pings it every minute while the site is healthy; you are alerted
# when the pings stop.
HEALTHCHECK_PING_URL=

# Forgotten owner password: set to 1 together with the new ADMIN_PASSWORD,
# restart, log in, then remove it again.
RESET_ADMIN_PASSWORD=

# Local or Docker PostgreSQL
POSTGRES_DB=blabla
POSTGRES_USER=blabla
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://blabla:replace-with-a-long-random-password@localhost:5432/blabla

# First owner account (created once at container startup)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-at-least-16-random-characters

# Public deployment
NEXT_PUBLIC_SITE_URL=https://cafe.example.com
APP_PORT=3000
UPLOAD_DIR=./storage/uploads

# Protects POST /api/meta/sync
CRON_SECRET=replace-with-another-long-random-secret

# Add only after the café authorizes its Instagram Professional account
META_GRAPH_VERSION=v24.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
